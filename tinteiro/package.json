{
  "name": "tinteiro",
  "productName": "Tinteiro",
  "version": "1.0.0",
  "description": "Editor de documentos (docx, xlsx, pdf, md) com visual de cofre de notas",
  "main": "src/main/main.js",
  "author": "Tinteiro",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "watch:web": "node scripts/build-web.mjs --watch",
    "server": "node src/server/standalone.js",
    "start": "npm run build:web && electron .",
    "test": "node test/run-all.mjs",
    "dist:win": "npm run build:web && electron-builder --win nsis --x64 --publish never",
    "android:sync": "npm run build:web && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "docx-preview": "^0.4.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hyperformula": "^3.5.0",
    "jsqr": "^1.4.0",
    "lucide": "^1.57.0",
    "markdown-it": "^15.0.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299"
  },
  "build": {
    "appId": "app.tinteiro.editor",
    "productName": "Tinteiro",
    "artifactName": "Tinteiro-Setup-${version}.${ext}",
    "copyright": "Tinteiro",
    "asar": false,
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/server/**",
      "src/shared/**",
      "dist/web/**",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map",
      "!node_modules/pdfjs-dist/{build,web,types,image_decoders,cmaps,standard_fonts,iccs}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Tinteiro"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tinteiro",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Tinteiro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "seinfrailheusprocessos-ship-it",
        "repo": "Omega",
        "releaseType": "release"
      }
    ]
  }
}
