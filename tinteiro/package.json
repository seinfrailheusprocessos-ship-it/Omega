{
  "name": "tinteiro",
  "productName": "Tinteiro",
  "version": "1.0.0",
  "description": "Editor de documentos (docx, xlsx, pdf, md) com visual de cofre de notas",
  "main": "src/main/main.js",
  "author": "Tinteiro",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "watch:web": "node scripts/build-web.mjs --watch",
    "server": "node src/server/standalone.js",
    "start": "npm run build:web && electron .",
    "test": "node test/run-all.mjs",
    "dist:win": "npm run build:web && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "docx-preview": "^0.4.1",
    "electron-updater": "^6.8.9",
    "hyperformula": "^3.5.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide": "^1.57.0",
    "markdown-it": "^15.0.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4"
  }
}
