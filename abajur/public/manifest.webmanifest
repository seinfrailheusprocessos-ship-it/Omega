{
  "name": "Abajur",
  "short_name": "Abajur",
  "description": "Atendimento, orçamentos com fotos, clientes e agenda do ateliê.",
  "lang": "pt-BR",
  "start_url": "./#inicio",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1c1c1e",
  "theme_color": "#1c1c1e",
  "icons": [
    { "src": "icons/icone-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "icons/icone-72.png", "sizes": "72x72", "type": "image/png" },
    { "src": "icons/icone-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "icons/icone-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/icone-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "icons/icone-152.png", "sizes": "152x152", "type": "image/png" },
    { "src": "icons/icone-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "icons/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icone-384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "icons/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "url",
      "files": [{ "name": "arquivos", "accept": ["image/*", "audio/*", "text/plain", "application/zip", ".zip", ".txt", ".opus"] }]
    }
  }
}
