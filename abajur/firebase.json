{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css|woff2|png|svg|gz)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
    ],
    "rewrites": [{ "source": "/compartilhar", "destination": "/index.html" }]
  }
}
